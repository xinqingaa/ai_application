{
  "dataset_version": "v0-lexical-exploration-1.0.0",
  "fixture_kind": "valid_business_queries_for_mechanism_observation",
  "description": "第 11 步 PostgreSQL FTS 探索性问题；用于观察词面强项与自然边界，不是 V0 acceptance 数据集。",
  "queries": [
    {
      "id": "exact_identifier",
      "text": "source_channel",
      "group": "精确标识",
      "expect": "接口约束 Chunk 应命中；技术标识词是 lexical 的强项。"
    },
    {
      "id": "mixed_identifier",
      "text": "售后接口 v2",
      "group": "中英混合",
      "expect": "中文词项和版本标识共同贡献候选与排序。"
    },
    {
      "id": "surface_match",
      "text": "申请售后",
      "group": "词面一致",
      "expect": "当前订单状态规则应命中。"
    },
    {
      "id": "question_noise",
      "text": "source_channel 什么时候必填？",
      "group": "自然问句",
      "expect": "问句填充词被过滤，精确标识仍能召回接口约束。"
    },
    {
      "id": "synonym_boundary",
      "text": "发起逆向服务",
      "group": "同义改写",
      "expect": "资料没有相同词面时可能无结果；这是 lexical 的自然边界。"
    },
    {
      "id": "negative_rule",
      "text": "虚拟商品 售后",
      "group": "否定约束",
      "expect": "可以命中例外规则，但高 rank 不代表应用已经理解否定关系。"
    },
    {
      "id": "normal_noise",
      "text": "售前活动入口",
      "group": "无关噪声",
      "expect": "可能无结果或只因通用词产生弱候选，不能把词面重合当证据。"
    }
  ]
}
