OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://...              # OpenAI 兼容平台时填写（见下方 DeepSeek 示例）
OPENAI_MODEL=gpt-4o-mini
# OPENAI_STRUCTURED_MODEL=gpt-4o           # chat.structured_chat 使用
# OPENAI_FALLBACK_MODEL=gpt-4o-mini        # chat.fallback_chat 使用

# Embedding（步骤 10）。默认不继承 OPENAI_BASE_URL，避免 chat 用 DeepSeek 时误打到无 embeddings 端点。
# Embedding 凭证必须显式配置，不自动复用 chat 的 OPENAI_API_KEY。
# OPENAI_EMBEDDING_API_KEY=sk-...
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL（步骤 11 起）。使用独立应用 role，不提交真实密码。
# DATABASE_URL=postgresql://review_assistant_app:change-me@127.0.0.1:5432/review_assistant
# TEST_DATABASE_URL=postgresql://review_assistant_app:change-me@127.0.0.1:5432/review_assistant_test

# DeepSeek 示例（chat 可用；Embedding 需另配支持 /embeddings 的平台）：
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
# OPENAI_STRUCTURED_MODEL=deepseek-chat
# OPENAI_EMBEDDING_API_KEY=sk-...
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
